---
// Todos los textos de esta página están en src/data/about.json
import SiteLayout from '../layouts/SiteLayout.astro';
import AboutHero from '../components/AboutHero.astro';
import ExperienceGrid from '../components/ExperienceGrid.astro';
import about from '../data/about.json';
import { rich } from '../utils/richText.js';

const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<SiteLayout pageTitle={about.pageTitle}>
    <main>
        <AboutHero
            kicker={about.kicker}
            ghost={about.ghost}
            title={about.title}
            highlight={about.highlight}
            imageUrl={about.photo.src}
            imageAlt={about.photo.alt}
            imageTag={about.photo.tag}
            imageCaption={about.photo.caption}
        >
            <ol class="border-t-2 border-orange-primary">
                {about.sections.map((section, i) => (
                    <li data-reveal class="grid gap-3 border-b border-white/10 py-8 sm:grid-cols-[9rem_1fr] sm:gap-8 lg:py-10">
                        <div>
                            <span class="index-num block">{pad(i)}</span>
                            <span class="kicker mt-1 block">{section.label}</span>
                        </div>
                        <p class="text-lg leading-relaxed text-gray-primary/85 lg:text-xl" set:html={rich(section.text)} />
                    </li>
                ))}
            </ol>

            <div data-reveal class="mt-10 flex flex-wrap gap-4">
                <a href={about.buttons.primary.href} target="_blank" rel="noopener noreferrer" class="btn-primary">
                    <i class={about.buttons.primary.icon} aria-hidden="true"></i>
                    <span>{about.buttons.primary.label}</span>
                </a>
                <a href={about.buttons.secondary.href} target="_blank" rel="noopener noreferrer" class="btn-outline group">
                    <span>{about.buttons.secondary.label}</span>
                    <i class={`${about.buttons.secondary.icon} text-sm`} aria-hidden="true"></i>
                </a>
            </div>
        </AboutHero>

        <ExperienceGrid />
    </main>
</SiteLayout>
