---
import PostLayout from "../../../layouts/PostLayout.astro";
import ArticleView from "../../../components/ArticleView.astro";
import blog from "../../../data/blog.json";
import PageHero from "../../../components/PageHero.astro";

import { sanityClient } from "sanity:client";
import type { SanityDocument } from "@sanity/client";

const { slug } = Astro.params;

const ZIP_BY_SLUG_QUERY = `*[
    contentType == "zip" && slug.current == "${slug}"
][0]{
    _id,
    title,
    excerpt,
    publishedAt,
    _updatedAt,
    body,
    "tags": tags[]->{
    name,
    "slug": slug.current,
    color,
    description
    }
}`;

const zip = await sanityClient.fetch<SanityDocument | null>(ZIP_BY_SLUG_QUERY);

if (!zip) {
    Astro.response.status = 404;
}

const canonicalURL = new URL(`/blog/zips/${slug}`, Astro.site).href;

---

<PostLayout pageTitle={zip?.title ?? `${blog.notFound.zip.title}${blog.notFound.zip.titleLight}`} canonicalURL={canonicalURL} description={zip?.excerpt}>
    {zip ? (
        <ArticleView doc={zip} canonicalURL={canonicalURL} kind="zip" />
    ) : (
        <PageHero title={blog.notFound.zip.title} titleLight={blog.notFound.zip.titleLight} kicker={blog.notFound.kicker} size="md">
            <p>{blog.notFound.zip.text}</p>
            <a slot="after" href={blog.notFound.zip.href} class="btn-outline">{blog.notFound.zip.button}</a>
        </PageHero>
    )}
</PostLayout>
