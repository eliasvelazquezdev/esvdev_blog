---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PageHero from '../../../components/PageHero.astro';
import { getTagColorClasses } from '../../../utils/tagColors.js';
import blog from '../../../data/blog.json';
import { rich, fmt } from '../../../utils/richText.js';
import { abs, breadcrumbNode, itemListNode, ogImageUrl, pageNode } from '../../../utils/seo.js';

import { sanityClient } from 'sanity:client';

const TAGS_QUERY = `*[_type == "tag"] {
  name,
  "slug": slug.current,
  description,
  color,
  featured,
  "postCount": count(*[_type == "post" && references(^._id)])
} | order(featured desc, postCount desc)`;

const tags = await sanityClient.fetch(TAGS_QUERY);
const activeTags = tags.filter((tag) => tag.postCount > 0);
const featuredTags = activeTags.filter((tag) => tag.featured);
const otherTags = activeTags.filter((tag) => !tag.featured);
const totalPosts = activeTags.reduce((acc, tag) => acc + tag.postCount, 0);

// Los textos de esta página están en src/data/blog.json → "tags"
const t = blog.tags;
const pageTitle = t.pageTitle;

// SEO
const url = abs('/blog/tags');
const ogImage = ogImageUrl('page', 'tags');
const jsonLd = [
    pageNode('CollectionPage', { url, title: t.seo.title, description: t.seo.description, image: ogImage, breadcrumb: true, extra: { mainEntity: { '@id': `${url}#list` } } }),
    breadcrumbNode(url, [{ name: 'Blog', path: '/blog' }, { name: t.title, path: '/blog/tags' }]),
    itemListNode(url, activeTags.map((tag) => ({ name: `#${tag.name}`, path: `/blog/tags/${tag.slug}/page1` }))),
];
---

<SiteLayout pageTitle={t.seo.title} description={t.seo.description} canonicalURL={url} ogImage={ogImage} jsonLd={jsonLd}>
    <PageHero title={t.title} kicker={t.kicker} ghost={t.ghost}>
        <Breadcrumbs slot="breadcrumbs" linkList={[{ label: t.title }]} />
        <p>{fmt(t.description, { count: String(activeTags.length).padStart(2, "0") })}</p>
    </PageHero>

    <main class="shell pb-20 lg:pb-28">
        {featuredTags.length > 0 && (
            <section class="mb-16 lg:mb-24">
                <p data-reveal class="kicker mb-6 !text-orange-secondary">
                    <i class="fa-solid fa-star mr-1.5" aria-hidden="true" /> {t.featuredLabel}
                </p>
                <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
                    {featuredTags.map((tag, i) => {
                        const c = getTagColorClasses(tag.color);
                        const share = totalPosts ? Math.round((tag.postCount / totalPosts) * 100) : 0;
                        return (
                            <a
                                href={`/blog/tags/${tag.slug}/page1`}
                                data-reveal
                                style={`--d: ${i * 90}ms`}
                                class="card card-hover group flex flex-col p-7 lg:p-8"
                                title={tag.description}
                            >
                                <div class="mb-8 flex items-center justify-between">
                                    <span class={`h-3 w-3 rounded-full ${c.dot} shadow-[0_0_14px_currentColor] ${c.text}`} aria-hidden="true" />
                                    <span class="text-5xl font-extralight tabular-nums leading-none text-orange-secondary/30 transition-colors duration-300 group-hover:text-orange-secondary/70">
                                        {String(tag.postCount).padStart(2, "0")}
                                    </span>
                                </div>
                                <h2 class="text-2xl font-bold tracking-tight text-gray-primary transition-colors duration-300 group-hover:text-orange-secondary lg:text-3xl">
                                    <span class="text-orange-secondary/60">#</span>{tag.name}
                                </h2>
                                {tag.description && (
                                    <p class="mt-3 text-base leading-relaxed text-gray-primary/65">{tag.description}</p>
                                )}
                                <div class="mt-auto pt-8">
                                    <div class="h-[2px] w-full overflow-hidden rounded-full bg-white/10">
                                        <span class="block h-full rounded-full bg-orange-secondary" style={`width: ${Math.max(share, 6)}%`} />
                                    </div>
                                    <p class="kicker mt-3">{tag.postCount} {tag.postCount === 1 ? t.post : t.posts}</p>
                                </div>
                                <span class="accent-line !h-[2px]" aria-hidden="true" />
                            </a>
                        );
                    })}
                </div>
            </section>
        )}

        <section>
            <h2 data-reveal class="section-title mb-10 lg:mb-14" set:html={rich(t.allTitle)} />
            <div class="border-t-2 border-orange-primary">
                {[...featuredTags, ...otherTags].map((tag, i) => {
                    const c = getTagColorClasses(tag.color);
                    return (
                        <a
                            href={`/blog/tags/${tag.slug}/page1`}
                            data-reveal
                            style={`--d: ${Math.min(i, 8) * 50}ms`}
                            class="group flex items-center gap-4 border-b border-white/10 py-5 transition-colors duration-300 hover:border-orange-primary lg:gap-8 lg:py-6"
                            title={tag.description}
                        >
                            <span class="index-num w-8 shrink-0 lg:w-10">{String(i + 1).padStart(2, "0")}</span>
                            <span class={`h-2 w-2 shrink-0 rounded-full ${c.dot}`} aria-hidden="true" />
                            <span class="min-w-0 flex-1 truncate text-xl font-bold tracking-tight text-gray-primary transition-colors duration-300 group-hover:text-orange-secondary lg:text-2xl">
                                #{tag.name}
                            </span>
                            {tag.featured && <span class="hidden rounded-full border border-orange-secondary/60 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-orange-secondary sm:inline">{t.featuredBadge}</span>}
                            <span class={`rounded-full px-2.5 py-0.5 text-xs font-semibold tabular-nums ${c.badge}`}>{tag.postCount}</span>
                            <i class="fa-solid fa-arrow-right -rotate-45 text-lg text-orange-secondary transition-transform duration-300 group-hover:rotate-0" aria-hidden="true" />
                        </a>
                    );
                })}
            </div>
        </section>
    </main>
</SiteLayout>
