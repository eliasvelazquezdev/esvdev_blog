---
import PostLayout from "../../layouts/PostLayout.astro";
import ArticleView from "../../components/ArticleView.astro";
import blog from "../../data/blog.json";
import PageHero from "../../components/PageHero.astro";

import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";

const { slug } = Astro.params;

const POST_BY_SLUG_QUERY = `*[
    contentType == "post" && slug.current == "${slug}"
][0]{
    _id,
    title,
    excerpt,
    publishedAt,
    _updatedAt,
    body,
    "tags": tags[]->{
    name,
    "slug": slug.current,
    color,
    description
    }
}`;

const post = await sanityClient.fetch<SanityDocument | null>(POST_BY_SLUG_QUERY);

if (!post) {
    Astro.response.status = 404;
}

// Generate canonical URL for this post
const canonicalURL = new URL(`/blog/${slug}`, Astro.site).href;



---

<PostLayout pageTitle={post?.title ?? `${blog.notFound.post.title}${blog.notFound.post.titleLight}`} canonicalURL={canonicalURL} description={post?.excerpt}>
    {post ? (
        <ArticleView doc={post} canonicalURL={canonicalURL} kind="post" />
    ) : (
        <PageHero title={blog.notFound.post.title} titleLight={blog.notFound.post.titleLight} kicker={blog.notFound.kicker} size="md">
            <p>{blog.notFound.post.text}</p>
            <a slot="after" href={blog.notFound.post.href} class="btn-outline">{blog.notFound.post.button}</a>
        </PageHero>
    )}
</PostLayout>
