---
import PostLayout from "../../layouts/PostLayout.astro";
import ArticleView from "../../components/ArticleView.astro";
import blog from "../../data/blog.json";
import { abs, blogNode, breadcrumbNode, ogImageUrl, pageNode, personRef, SITE_URL } from "../../utils/seo.js";
import { articleStats } from "../../utils/article.js";
import PageHero from "../../components/PageHero.astro";

import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";

const { slug } = Astro.params;

// El slug viaja como parámetro ($slug), nunca concatenado en la consulta.
// seoTitle / seoDescription / coverImage son opcionales: si existen en Sanity se usan;
// si no, se usan el título, el extracto y la miniatura generada automáticamente.
const POST_BY_SLUG_QUERY = `*[
    contentType == "post" && slug.current == $slug
][0]{
    _id,
    title,
    excerpt,
    publishedAt,
    _updatedAt,
    body,
    "seoTitle": coalesce(seoTitle, seo.title, metaTitle),
    "seoDescription": coalesce(seoDescription, seo.description, metaDescription),
    "coverImage": coalesce(mainImage.asset->url, coverImage.asset->url, image.asset->url),
    "tags": tags[]->{
    name,
    "slug": slug.current,
    color,
    description
    }
}`;

const post = await sanityClient.fetch<SanityDocument | null>(POST_BY_SLUG_QUERY, { slug });
// Tolerancia a datos incompletos: se omiten referencias a tags borrados
if (post?.tags) post.tags = post.tags.filter(Boolean);

if (!post) {
    Astro.response.status = 404;
}

// ===== SEO =====
const canonical = abs(`/blog/${slug}`);
const { words, minutes } = articleStats(post?.body ?? []);
const seoTitle = post?.seoTitle || post?.title;
const seoDescription = post?.seoDescription || post?.excerpt || undefined;
const tagNames = (post?.tags ?? []).map((t) => t.name);
const ogImage = post?.coverImage
    ? `${post.coverImage}?w=1200&h=630&fit=crop&fm=jpg&q=85`
    : ogImageUrl("post", String(slug), post?._updatedAt);
const jsonLd = post
    ? [
          blogNode(),
          {
              "@type": "BlogPosting",
              "@id": `${canonical}#article`,
              mainEntityOfPage: { "@id": `${canonical}#webpage` },
              headline: post.title,
              description: seoDescription,
              image: { "@type": "ImageObject", url: ogImage, width: 1200, height: 630 },
              datePublished: post.publishedAt,
              dateModified: post._updatedAt ?? post.publishedAt,
              author: personRef,
              publisher: personRef,
              isPartOf: { "@id": `${SITE_URL}/#blog` },
              articleSection: "Blog",
              keywords: tagNames,
              about: tagNames.map((name) => ({ "@type": "Thing", name })),
              wordCount: words,
              timeRequired: `PT${minutes}M`,
              inLanguage: "es",
          },
          pageNode("WebPage", { url: canonical, title: seoTitle, description: seoDescription, image: ogImage, breadcrumb: true }),
          breadcrumbNode(canonical, [
              { name: "Blog", path: "/blog" },
              { name: post.title, path: `/blog/${slug}` },
          ]),
      ]
    : [];
---

<PostLayout
    pageTitle={post ? seoTitle : `${blog.notFound.post.title}${blog.notFound.post.titleLight}`}
    description={seoDescription}
    canonicalURL={canonical}
    ogImage={post ? ogImage : undefined}
    ogType={post ? "article" : "website"}
    article={post ? { publishedTime: post.publishedAt, modifiedTime: post._updatedAt, section: "Blog", tags: tagNames } : undefined}
    jsonLd={jsonLd}
    noindex={!post}
>
    {post ? (
        <ArticleView doc={post} canonicalURL={canonical} kind="post" />
    ) : (
        <PageHero title={blog.notFound.post.title} titleLight={blog.notFound.post.titleLight} kicker={blog.notFound.kicker} size="md">
            <p>{blog.notFound.post.text}</p>
            <a slot="after" href={blog.notFound.post.href} class="btn-outline">{blog.notFound.post.button}</a>
        </PageHero>
    )}
</PostLayout>
