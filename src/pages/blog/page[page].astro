---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PostDescription from '../../components/PostDescription.astro';
import PaginationArrowsForPosts from '../../components/PaginationArrowsForPosts.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import blog from '../../data/blog.json';
import { fmt } from '../../utils/richText.js';
import { abs, breadcrumbNode, itemListNode, ogImageUrl, pageNode } from '../../utils/seo.js';

import { sanityClient } from "sanity:client";

export const prerender = true;
export async function getStaticPaths() {
    const TOTAL_POSTS_COUNT = `count(*[_type == "post"])`;
    const totalPosts = await sanityClient.fetch(TOTAL_POSTS_COUNT);

    const postsPerPage = 5;
    const totalPages = Math.ceil(totalPosts / postsPerPage);

    const paths = [];
    for (let i = 1; i <= totalPages; i++) {
    paths.push({
        params: { page: i.toString() },
    });
    }

    return paths;
}

const { page } = Astro.params;
const currentPage = parseInt(page) || 1;
const postsPerPage = 5;
const offset = (currentPage - 1) * postsPerPage;

const POSTS_QUERY = `{
  "posts": *[contentType == "post"] | order(publishedAt desc) [${offset}...${offset + postsPerPage}] {
    _id,
    title,
    slug,
    excerpt,
    publishedAt
  },
  "total": count(*[_type == "post"])
}`;

const { posts: rawPosts, total } = await sanityClient.fetch(POSTS_QUERY);
// Tolerancia a datos incompletos: se omiten documentos sin slug y referencias a tags borrados
const posts = (rawPosts ?? []).filter((p) => p?.slug?.current);

const totalPages = Math.ceil(total / postsPerPage);
const hasNext = currentPage < totalPages;
const hasPrev = currentPage > 1;
const nextPage = hasNext ? currentPage + 1 : null;
const prevPage = hasPrev ? currentPage - 1 : null;

// Los textos de esta página están en src/data/blog.json → "postsPage"
const t = blog.postsPage;
const pageTitle = fmt(t.pageTitle, { page: currentPage });

// SEO: cada página del archivo es indexable con su propia URL canónica
const url = abs(`/blog/page${currentPage}`);
const seoTitle = fmt(t.seo.title, { page: currentPage });
const seoDescription = fmt(t.seo.description, { page: currentPage, total: totalPages });
const jsonLd = [
    pageNode('CollectionPage', { url, title: seoTitle, description: seoDescription, breadcrumb: true, extra: { mainEntity: { '@id': `${url}#list` } } }),
    breadcrumbNode(url, [{ name: 'Blog', path: '/blog' }, { name: fmt(t.breadcrumbPage, { page: currentPage }), path: `/blog/page${currentPage}` }]),
    itemListNode(url, posts.map((p) => ({ name: p.title, path: `/blog/${p.slug.current}` }))),
];
---

<SiteLayout pageTitle={seoTitle} description={seoDescription} canonicalURL={url} ogImage={ogImageUrl('page', 'blog')} jsonLd={jsonLd}>
    <PageHero title={t.title} titleLight={t.titleLight} ghost={t.ghost} size="md">
        <Breadcrumbs
            slot="breadcrumbs"
            linkList={[
                { label: "Blog", link: "/blog" },
                { label: fmt(t.breadcrumbPage, { page: currentPage }) },
            ]}
        />
        <p>{fmt(t.description, { page: currentPage, total: totalPages })}</p>
    </PageHero>

    <main class="shell pb-20 lg:pb-28">
        <div>
            {posts.map((post, i) => (
                <PostDescription
                    index={offset + i}
                    postURL={`/blog/${post.slug.current}`}
                    postTitle={post.title}
                    postDate={post.publishedAt}
                    postDescription={post.excerpt}
                />
            ))}
        </div>

        <PaginationArrowsForPosts
            next={nextPage ? `/blog/page${nextPage}` : null}
            prev={prevPage ? `/blog/page${prevPage}` : null}
            currentPage={currentPage}
            totalPages={totalPages}
        />
    </main>
</SiteLayout>
