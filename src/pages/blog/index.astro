---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHero from "../../components/PageHero.astro";
import PostDescription from "../../components/PostDescription.astro";
import blog from "../../data/blog.json";
import { rich } from "../../utils/richText.js";

import { sanityClient } from "sanity:client";
import type { SanityDocument } from "@sanity/client";

const FEATURED_POSTS_QUERY = `*[
	contentType == "post" && featured == true
]|order(publishedAt desc){_id, title, slug, excerpt, publishedAt}
`;

const featured_posts = await sanityClient.fetch<SanityDocument[]>(FEATURED_POSTS_QUERY);

const LATEST_POSTS_QUERY = `*[
  contentType == "post"
]|order(publishedAt desc)[0...5]{_id, title, slug, excerpt, publishedAt}
`;
const latest_posts = await sanityClient.fetch<SanityDocument[]>(LATEST_POSTS_QUERY);

// Los textos de esta página están en src/data/blog.json → "blogIndex"
const t = blog.blogIndex;
const pageTitle = t.pageTitle;
---

<SiteLayout pageTitle={pageTitle}>
  <PageHero title={t.hero.title} titleLight={t.hero.titleLight} kicker={t.hero.kicker} ghost={t.hero.ghost}>
    <p set:html={rich(t.hero.description)} />
  </PageHero>

  <main class="shell pb-20 lg:pb-28">
    <!-- Intro -->
    <section class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="space-y-6 text-lg leading-relaxed text-gray-primary/80 lg:col-span-7 lg:text-xl">
        <p data-reveal class="text-2xl font-bold leading-snug tracking-tight text-gray-primary lg:text-3xl" set:html={rich(t.lead)} />
        {t.paragraphs.map((text) => <p data-reveal set:html={rich(text)} />)}
      </div>

      <aside class="lg:col-span-5">
        <a
          href={t.proTip.href}
          data-reveal
          class="card card-hover group block p-7 lg:p-9"
        >
          <div class="mb-5 flex items-center justify-between">
            <span class="kicker !text-orange-secondary">{t.proTip.kicker}</span>
            <span class="flex h-11 w-11 items-center justify-center rounded-xl border border-orange-secondary/50 bg-orange-secondary/10 text-orange-secondary">
              <i class="fa-solid fa-bolt" aria-hidden="true"></i>
            </span>
          </div>
          <p class="text-2xl font-bold leading-snug tracking-tight text-gray-primary lg:text-3xl" set:html={rich(t.proTip.text)} />
          <span class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-orange-secondary">
            {t.proTip.linkLabel}
            <i class="fa-solid fa-arrow-right text-xs transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"></i>
          </span>
          <span class="accent-line !h-[2px]" aria-hidden="true"></span>
        </a>
      </aside>
    </section>

    <!-- Destacados -->
    {
      featured_posts.length > 0 && (
        <section class="mt-24 lg:mt-32">
          <div class="mb-10 flex items-end justify-between gap-6 lg:mb-14">
            <h2 data-reveal class="section-title" set:html={rich(t.featuredTitle)} />
            <span data-reveal class="index-num hidden sm:block">
              {String(featured_posts.length).padStart(2, "0")} {t.featuredCountLabel}
            </span>
          </div>
          <div class="grid gap-6 md:grid-cols-2 lg:gap-8 xl:grid-cols-3">
            {featured_posts.map((post, i) => (
              <PostDescription
                variant="card"
                index={i}
                postURL={`/blog/${post.slug.current}`}
                postTitle={post.title}
                postDate={post.publishedAt}
                postDescription={post.excerpt}
              />
            ))}
          </div>
        </section>
      )
    }

    <!-- Últimos posts -->
    <section class="mt-24 lg:mt-32">
      <div class="mb-4 flex items-end justify-between gap-6 lg:mb-6">
        <h2 data-reveal class="section-title" set:html={rich(t.latestTitle)} />
        <a data-reveal href="/blog/page1" class="group hidden items-center gap-2 font-bold text-orange-secondary sm:inline-flex">
          {t.seeAll}
          <i class="fa-solid fa-arrow-right text-sm transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"></i>
        </a>
      </div>

      <div>
        {
          latest_posts.map((post, i) => (
            <PostDescription
              index={i}
              postURL={`/blog/${post.slug.current}`}
              postTitle={post.title}
              postDate={post.publishedAt}
              postDescription={post.excerpt}
            />
          ))
        }
      </div>

      <div data-reveal class="mt-12 flex justify-center">
        <a href="/blog/page1" class="btn-outline group">
          <span>{t.allPostsButton}</span>
          <i class="fa-solid fa-arrow-right text-sm transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"></i>
        </a>
      </div>
    </section>
  </main>
</SiteLayout>
