---
import blog from "../data/blog.json";

interface Props {
  linkList: { label: string; link?: string }[];
}

const { linkList } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-semibold uppercase tracking-[0.18em]">
    <li>
      <a href="/" class="inline-flex items-center gap-2 text-gray-primary/55 transition-colors hover:text-orange-secondary">
        <i class="fa-solid fa-house text-[0.9em]" aria-hidden="true"></i>
        {blog.ui.home}
      </a>
    </li>
    {
      linkList.map((item) => (
        <li class="flex items-center gap-2">
          <span class="text-orange-secondary/60" aria-hidden="true">/</span>
          {item.link !== undefined ? (
            <a href={item.link} class="text-gray-primary/55 transition-colors hover:text-orange-secondary">
              {item.label}
            </a>
          ) : (
            <span class="text-orange-secondary" aria-current="page">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
