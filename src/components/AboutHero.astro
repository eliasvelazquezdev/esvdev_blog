---
import PlexusBackground from "./PlexusBackground.astro";

interface Props {
  kicker?: string;
  ghost?: string;
  title: string;
  highlight: string;
  imageUrl: string;
  imageAlt?: string;
  imageTag?: string;
  imageCaption?: string;
}

const { kicker, ghost, title, highlight, imageUrl, imageAlt = "Foto del autor", imageTag, imageCaption } = Astro.props;
---

<section class="relative overflow-x-clip" data-purpose="about-hero">
  <!-- Encabezado -->
  <div class="relative overflow-hidden pb-10 pt-32 lg:pb-16 lg:pt-44">
    <PlexusBackground density="soft" />
    {ghost && <span class="ghost-word -right-4 top-24 z-[1] text-[22vw] lg:text-[16vw]" aria-hidden="true">{ghost}</span>}
    <div class="shell relative z-10">
      {kicker && <p class="hero-appear kicker mb-5 !text-orange-secondary">{kicker}</p>}
      <h1
        data-bg-quiet
        class="hero-appear max-w-5xl text-5xl font-extrabold leading-[1.02] tracking-tight text-gray-primary sm:text-6xl lg:text-7xl xl:text-8xl"
        style="--d: 120ms; text-shadow: 0 2px 18px rgba(8, 18, 40, 0.7);"
      >
        {title}
      </h1>
      <p
        data-bg-quiet
        class="hero-appear mt-4 text-2xl font-normal tracking-tight text-orange-secondary sm:text-3xl lg:text-4xl"
        style="--d: 220ms"
      >
        {highlight}
      </p>
    </div>
  </div>

  <!-- Contenido -->
  <div class="shell relative grid items-start gap-12 pb-20 lg:grid-cols-12 lg:gap-14 lg:pb-28 xl:gap-20">
    <aside class="flex justify-center lg:sticky lg:top-32 lg:col-span-5" data-purpose="image-container">
      <figure
        data-reveal
        class="relative w-full max-w-md overflow-hidden rounded-3xl border-2 border-orange-primary bg-blue-secondary xl:max-w-[28rem]"
      >
        <div class="aspect-[4/5] w-full overflow-hidden lg:max-h-[calc(100vh-13rem)]">
          <img src={imageUrl} alt={imageAlt} class="h-full w-full object-cover" />
        </div>
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-blue-primary via-blue-primary/10 to-transparent" aria-hidden="true"></div>
        {
          (imageTag || imageCaption) && (
            <figcaption class="absolute inset-x-0 bottom-0 p-5 lg:p-7">
              {imageTag && (
                <span class="mb-3 inline-flex items-center gap-1.5 rounded-full border border-orange-secondary/60 bg-blue-primary/60 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-orange-secondary backdrop-blur-sm">
                  <i class="fa-solid fa-location-dot" aria-hidden="true" />
                  {imageTag}
                </span>
              )}
              {imageCaption && <p class="text-sm font-medium leading-snug text-gray-primary lg:text-base">{imageCaption}</p>}
            </figcaption>
          )
        }
      </figure>
    </aside>

    <div class="lg:col-span-7" data-purpose="bio-content">
      <slot />
    </div>
  </div>
</section>
