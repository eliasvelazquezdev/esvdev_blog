---
import blog from "../data/blog.json";

interface Props {
  zip: {
    title: string;
    excerpt?: string;
    slug?: {
      current?: string;
    };
  };
  className?: string;
  index?: number;
}

const { zip, className = "", index } = Astro.props as Props;
const slug = zip.slug?.current;
const href = slug ? `/blog/zips/${slug}` : "/blog/zips/";
const number = index !== undefined ? String(index + 1).padStart(2, "0") : null;
---

<a
  href={href}
  data-reveal
  style={index !== undefined ? `--d: ${(index % 4) * 80}ms` : undefined}
  class={`card card-hover group flex h-full flex-col p-7 lg:p-8 ${className}`}
  aria-label={`Leer zip: ${zip.title}`}
>
  <div class="mb-7 flex items-center justify-between">
    <span
      class="flex h-11 w-11 items-center justify-center rounded-xl border border-orange-secondary/50 bg-orange-secondary/10 text-orange-secondary transition-[transform,background-color] duration-300 group-hover:rotate-[-8deg] group-hover:bg-orange-secondary group-hover:text-blue-primary"
    >
      <i class="fa-solid fa-bolt" aria-hidden="true"></i>
    </span>
    {number && <span class="index-num">{number}</span>}
  </div>

  <h3 class="text-xl font-bold leading-snug tracking-tight text-gray-primary transition-colors duration-300 group-hover:text-orange-secondary lg:text-2xl">
    {zip.title}
  </h3>

  {zip.excerpt && <p class="mt-3 text-base leading-relaxed text-gray-primary/65">{zip.excerpt}</p>}

  <span class="mt-auto inline-flex items-center gap-2 pt-7 text-sm font-bold text-orange-secondary">
    {blog.zips.cardCta}
    <i class="fa-solid fa-arrow-right text-xs transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"></i>
  </span>
  <span class="accent-line !h-[2px]" aria-hidden="true"></span>
</a>
