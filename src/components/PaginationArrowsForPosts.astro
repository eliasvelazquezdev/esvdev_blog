---
// Paginación numerada: flechas + números de página (1 … 4 5 6 … 12).
// En pantallas chicas se muestran menos números para que entre en una línea.
import blog from "../data/blog.json";
import { fmt } from "../utils/richText.js";

interface Props {
  next?: string | null;
  prev?: string | null;
  currentPage: number;
  totalPages: number;
  /** Base de la URL de cada página: se le agrega el número (ej. "/blog/page" → "/blog/page4") */
  baseHref: string;
  /** Texto extra junto al contador (ej. nombre del tag) */
  context?: string;
}

const { next, prev, currentPage, totalPages, baseHref, context } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
const hrefFor = (n: number) => `${baseHref}${n}`;

/** Lista de páginas a mostrar: primera, última y `siblings` a cada lado de la actual, con "…" en los saltos */
const pagesFor = (siblings: number): (number | "gap")[] => {
  const set = new Set([1, totalPages]);
  for (let i = currentPage - siblings; i <= currentPage + siblings; i++) if (i >= 1 && i <= totalPages) set.add(i);
  const sorted = [...set].sort((a, b) => a - b);
  const out: (number | "gap")[] = [];
  sorted.forEach((n, i) => {
    const before = sorted[i - 1];
    if (before !== undefined) {
      if (n - before === 2) out.push(before + 1); // un solo hueco: se muestra el número en vez de "…"
      else if (n - before > 2) out.push("gap");
    }
    out.push(n);
  });
  return out;
};

const variants = [
  { pages: pagesFor(0), class: "flex sm:hidden" },
  { pages: pagesFor(1), class: "hidden sm:flex" },
];

const arrow = "group flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 transition-colors duration-300 sm:h-12 sm:w-12";
const arrowOn = `${arrow} border-orange-secondary/70 text-orange-secondary hover:border-orange-secondary hover:bg-orange-secondary hover:text-blue-primary`;
const arrowOff = `${arrow} border-white/10 text-white/20`;
const num = "flex h-10 min-w-10 items-center justify-center rounded-full px-2 text-sm font-bold tabular-nums transition-colors duration-300 sm:h-11 sm:min-w-11 sm:text-base";
---

{
  totalPages > 1 && (
    <nav class="mt-14 flex flex-col items-center gap-4" aria-label="Paginación">
      <div class="flex items-center gap-2 sm:gap-4">
        {prev ? (
          <a href={prev} class={arrowOn} aria-label={blog.ui.prevPage}>
            <i class="fa-solid fa-arrow-left transition-transform duration-300 group-hover:-translate-x-0.5" aria-hidden="true" />
          </a>
        ) : (
          <span class={arrowOff} aria-hidden="true">
            <i class="fa-solid fa-arrow-left" />
          </span>
        )}

        {variants.map((v) => (
          <ol class:list={[v.class, "items-center gap-1 sm:gap-2"]}>
            {v.pages.map((p) =>
              p === "gap" ? (
                <li class="flex h-10 w-6 items-end justify-center pb-2 text-gray-primary/40 sm:h-11" aria-hidden="true">
                  …
                </li>
              ) : (
                <li>
                  {p === currentPage ? (
                    <span class={`${num} bg-orange-secondary text-blue-primary`} aria-current="page">
                      {p}
                    </span>
                  ) : (
                    <a href={hrefFor(p)} class={`${num} text-gray-primary/70 hover:bg-white/5 hover:text-orange-secondary`} aria-label={fmt(blog.ui.goToPage, { page: p })}>
                      {p}
                    </a>
                  )}
                </li>
              ),
            )}
          </ol>
        ))}

        {next ? (
          <a href={next} class={arrowOn} aria-label={blog.ui.nextPage}>
            <i class="fa-solid fa-arrow-right transition-transform duration-300 group-hover:translate-x-0.5" aria-hidden="true" />
          </a>
        ) : (
          <span class={arrowOff} aria-hidden="true">
            <i class="fa-solid fa-arrow-right" />
          </span>
        )}
      </div>

      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-primary/50">
        {blog.ui.pageLabel} <span class="text-orange-secondary">{pad(currentPage)}</span> / {pad(totalPages)}
        {context && <span class="ml-1 normal-case tracking-normal text-gray-primary/40">· {context}</span>}
      </p>
    </nav>
  )
}
