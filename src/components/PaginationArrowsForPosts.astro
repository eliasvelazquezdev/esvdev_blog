---
import blog from "../data/blog.json";

interface Props {
  next?: string | null;
  prev?: string | null;
  currentPage: number;
  totalPages: number;
  /** Texto extra junto al contador (ej. nombre del tag) */
  context?: string;
}

const { next, prev, currentPage, totalPages, context } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
const progress = totalPages > 0 ? (currentPage / totalPages) * 100 : 0;
---

<nav class="mt-14 flex items-center gap-4 lg:gap-8" aria-label="Paginación">
  {
    prev ? (
      <a
        href={prev}
        class="group flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 border-orange-secondary/70 text-orange-secondary transition-colors duration-300 hover:border-orange-secondary hover:bg-orange-secondary hover:text-blue-primary"
        aria-label={blog.ui.prevPage}
      >
        <i class="fa-solid fa-arrow-left transition-transform duration-300 group-hover:-translate-x-0.5" aria-hidden="true" />
      </a>
    ) : (
      <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 border-white/10 text-white/20" aria-hidden="true">
        <i class="fa-solid fa-arrow-left" />
      </span>
    )
  }

  <div class="min-w-0 flex-1">
    <div class="relative h-[2px] w-full overflow-hidden rounded-full bg-white/10">
      <span class="absolute inset-y-0 left-0 rounded-full bg-orange-secondary" style={`width: ${progress}%`}></span>
    </div>
    <p class="mt-3 text-xs font-semibold uppercase tracking-[0.2em] text-gray-primary/50">
      <span class="text-orange-secondary">{pad(currentPage)}</span> / {pad(totalPages)}
      {context && <span class="ml-2 normal-case tracking-normal text-gray-primary/40">· {context}</span>}
    </p>
  </div>

  {
    next ? (
      <a
        href={next}
        class="group flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 border-orange-secondary/70 text-orange-secondary transition-colors duration-300 hover:border-orange-secondary hover:bg-orange-secondary hover:text-blue-primary"
        aria-label={blog.ui.nextPage}
      >
        <i class="fa-solid fa-arrow-right transition-transform duration-300 group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
    ) : (
      <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 border-white/10 text-white/20" aria-hidden="true">
        <i class="fa-solid fa-arrow-right" />
      </span>
    )
  }
</nav>
