---
import site from "../data/site.json";
import blog from "../data/blog.json";
import { fmt } from "../utils/richText.js";

interface Props {
  publishedAt: Date | string;
  updatedAt?: Date | string;
  readingTime?: number;
}

const { publishedAt, updatedAt, readingTime } = Astro.props;

function formatDate(date: Date | string) {
  return new Date(date).toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" });
}

const pubDateStr = formatDate(publishedAt);
const upDateStr = updatedAt ? formatDate(updatedAt) : null;
const isUpdated = upDateStr && upDateStr !== pubDateStr;
const { author } = site;
---

<div class="flex flex-wrap items-center gap-x-8 gap-y-5" data-purpose="author-byline">
  <div class="flex items-center gap-4">
    <img
      alt={`Autor: ${author.name}`}
      class="h-14 w-14 rounded-full border-[3px] border-orange-secondary object-cover shadow-[0_10px_30px_-10px_rgba(244,165,24,0.6)]"
      src={author.avatar}
    />
    <div>
      <p class="text-base font-bold tracking-tight text-gray-primary">{author.name}</p>
      <p class="text-sm text-gray-primary/60">{author.role}</p>
    </div>
  </div>

  <span class="hidden h-10 w-px bg-white/15 sm:block" aria-hidden="true"></span>

  <dl class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
    <div class="flex items-center gap-2 text-gray-primary/70">
      <dt class="sr-only">Publicado</dt>
      <i class="fa-regular fa-calendar text-orange-secondary" aria-hidden="true"></i>
      <dd><time datetime={new Date(publishedAt).toISOString()}>{pubDateStr}</time></dd>
    </div>
    {
      readingTime && (
        <div class="flex items-center gap-2 text-gray-primary/70">
          <dt class="sr-only">Tiempo de lectura</dt>
          <i class="fa-regular fa-clock text-orange-secondary" aria-hidden="true" />
          <dd>{fmt(blog.article.readingTime, { min: readingTime })}</dd>
        </div>
      )
    }
    {
      isUpdated && (
        <div class="flex items-center gap-2 text-orange-secondary/90">
          <dt class="sr-only">Actualizado</dt>
          <i class="fa-solid fa-rotate text-xs" aria-hidden="true" />
          <dd>
            {blog.article.updated} <time datetime={new Date(updatedAt!).toISOString()}>{upDateStr}</time>
          </dd>
        </div>
      )
    }
  </dl>
</div>
