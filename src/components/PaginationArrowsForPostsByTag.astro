---
import PaginationArrowsForPosts from "./PaginationArrowsForPosts.astro";

interface Props {
  next?: string | null;
  prev?: string | null;
  tagName: string;
  currentPage?: number;
  totalPages?: number;
}

const { next, prev, tagName, currentPage = 1, totalPages = 1 } = Astro.props;
---

<PaginationArrowsForPosts next={next} prev={prev} currentPage={currentPage} totalPages={totalPages} context={`#${tagName}`} />
