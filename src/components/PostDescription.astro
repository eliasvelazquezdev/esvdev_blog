---
import blog from "../data/blog.json";

interface Props {
  postTitle: string;
  postDescription: string;
  postDate: string | Date;
  postURL: string;
  /** Se mantiene por compatibilidad: todas las variantes son clickeables */
  clickableCard?: boolean;
  className?: string;
  /** Posición en la lista (muestra 01, 02...) */
  index?: number;
  /** "row": fila tipo lista (como Projects en la web) · "card": tarjeta destacada */
  variant?: "row" | "card";
  label?: string;
}

const {
  postTitle,
  postDescription,
  postDate,
  postURL,
  className = "",
  index,
  variant = "row",
  label = blog.cards.featuredBadge,
} = Astro.props;

const date = postDate ? new Date(postDate) : null;
const dateLabel = date
  ? date.toLocaleDateString("es-ES", { day: "2-digit", month: "short", year: "numeric" }).replace(".", "")
  : "";
const number = index !== undefined ? String(index + 1).padStart(2, "0") : null;
---

{
  variant === "card" ? (
    <a
      href={postURL}
      data-reveal
      style={index !== undefined ? `--d: ${index * 90}ms` : undefined}
      class={`card card-hover group flex h-full flex-col p-7 lg:p-9 ${className}`}
      aria-label={`Leer post: ${postTitle}`}
    >
      <div class="mb-8 flex items-center justify-between gap-4">
        <span class="inline-flex items-center gap-2 rounded-full border border-orange-secondary/60 bg-blue-primary/50 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-orange-secondary">
          <i class="fa-solid fa-star text-[0.85em]" aria-hidden="true" />
          {label}
        </span>
        {number && <span class="text-5xl font-extralight tabular-nums leading-none text-orange-secondary/25 lg:text-6xl">{number}</span>}
      </div>

      <h3 class="text-2xl font-bold leading-snug tracking-tight text-gray-primary transition-colors duration-300 group-hover:text-orange-secondary lg:text-[1.75rem]">
        {postTitle}
      </h3>

      {postDescription && <p class="mt-4 line-clamp-4 text-base leading-relaxed text-gray-primary/70">{postDescription}</p>}

      <div class="mt-auto flex items-center justify-between gap-4 pt-8">
        {dateLabel && (
          <time datetime={date!.toISOString()} class="kicker">
            {dateLabel}
          </time>
        )}
        <span class="inline-flex items-center gap-2 text-sm font-bold text-orange-secondary">
          {blog.cards.readMore}
          <i class="fa-solid fa-arrow-right text-xs transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true" />
        </span>
      </div>
      <span class="accent-line" aria-hidden="true" />
    </a>
  ) : (
    <a
      href={postURL}
      data-reveal
      style={index !== undefined ? `--d: ${Math.min(index, 6) * 70}ms` : undefined}
      class={`group relative block border-b-2 border-orange-primary/70 py-7 transition-colors duration-300 hover:border-orange-primary lg:py-9 ${className}`}
      aria-label={`Leer post: ${postTitle}`}
    >
      <div class="flex items-start justify-between gap-6">
        <div class="flex min-w-0 items-baseline gap-4 lg:gap-6">
          {number && <span class="index-num w-7 shrink-0 transition-colors duration-300 group-hover:text-orange-secondary lg:w-10">{number}</span>}
          <div class="min-w-0">
            <h3 class="text-2xl font-bold leading-snug tracking-tight text-gray-primary transition-colors duration-300 group-hover:text-orange-secondary lg:text-3xl">
              {postTitle}
            </h3>
            {dateLabel && (
              <time datetime={date!.toISOString()} class="kicker mt-2 block">
                {dateLabel}
              </time>
            )}
            {postDescription && (
              <p class="mt-4 max-w-3xl text-base leading-relaxed text-gray-primary/70 lg:text-lg">{postDescription}</p>
            )}
          </div>
        </div>
        <i
          class="fa-solid fa-arrow-right mt-2 shrink-0 -rotate-45 text-2xl text-orange-secondary transition-[transform,color] duration-300 group-hover:rotate-0 group-hover:text-orange-primary lg:text-3xl"
          aria-hidden="true"
        />
      </div>
    </a>
  )
}
