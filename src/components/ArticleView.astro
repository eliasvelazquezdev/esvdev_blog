---
// Vista completa de un artículo (post o zip): encabezado, cuerpo, índice lateral y cierre.
import PlexusBackground from "./PlexusBackground.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import AuthorLayout from "./AuthorLayout.astro";
import TableOfContents from "./TableOfContents.astro";
import ShareButtons from "./ShareButtons.astro";
import TagChip from "./TagChip.astro";
import { PortableText } from "astro-portabletext";
import { components } from "./PortableTextComponents.jsx";
import site from "../data/site.json";
import blog from "../data/blog.json";
import { fmt } from "../utils/richText.js";
import { articleStats } from "../utils/article.js";

interface Props {
  doc: {
    title: string;
    excerpt?: string;
    publishedAt: string;
    _updatedAt?: string;
    body?: any[];
    tags?: { name: string; slug: string; color?: string; description?: string }[];
  };
  canonicalURL: string;
  kind?: "post" | "zip";
}

const { doc, canonicalURL, kind = "post" } = Astro.props;
const portableText = doc.body ?? [];

// Tiempo de lectura estimado (~200 palabras por minuto)
const { minutes: readingTime } = articleStats(portableText);

const hasToc = portableText.some((b: any) => b._type === "block" && ["h1", "h2", "h3", "h4"].includes(b.style));
const section = kind === "zip" ? { label: "Zips", link: "/blog/zips" } : { label: "Blog", link: "/blog" };
const t = blog.article;
const { author } = site;
---

<!-- Encabezado -->
<header class="relative overflow-hidden pb-14 pt-32 lg:pb-20 lg:pt-44" data-purpose="article-header">
  <PlexusBackground density="soft" />

  <div class="shell relative z-10">
    <div class="hero-appear mb-8">
      <Breadcrumbs linkList={[section, { label: kind === "zip" ? t.breadcrumbZip : t.breadcrumbPost }]} />
    </div>

    {
      doc.tags && doc.tags.length > 0 && (
        <div class="hero-appear mb-6 flex flex-wrap gap-2" style="--d: 60ms">
          {doc.tags.map((tag) => (
            <TagChip name={tag.name} slug={tag.slug} color={tag.color} description={tag.description} />
          ))}
        </div>
      )
    }

    <h1
      data-bg-quiet
      class="hero-appear max-w-5xl text-4xl font-extrabold leading-[1.08] tracking-tight text-gray-primary sm:text-5xl lg:text-6xl xl:text-7xl"
      style="--d: 120ms; text-shadow: 0 2px 18px rgba(8, 18, 40, 0.7);"
    >
      {doc.title}
    </h1>

    {
      doc.excerpt && (
        <p data-bg-quiet class="hero-appear mt-7 max-w-3xl text-lg leading-relaxed text-gray-primary/75 lg:text-xl" style="--d: 220ms">
          {doc.excerpt}
        </p>
      )
    }

    <div class="hero-appear mt-10 border-t border-white/10 pt-8" style="--d: 320ms">
      <AuthorLayout publishedAt={doc.publishedAt} updatedAt={doc._updatedAt} readingTime={readingTime} />
    </div>
  </div>
</header>

<!-- Cuerpo -->
<main class="shell pb-16 lg:pb-24" data-purpose="main-article-content">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-10 xl:gap-16">
    <div class="min-w-0 lg:col-span-8">
      {hasToc && <div class="lg:hidden"><TableOfContents items={portableText} variant="inline" /></div>}

      <article class="content mx-auto max-w-[46rem] lg:mx-0">
        <PortableText value={portableText} components={components} />
      </article>

      <!-- Cierre -->
      <footer class="mt-16 max-w-[46rem] space-y-10 border-t-2 border-orange-primary pt-10">
        {
          doc.tags && doc.tags.length > 0 && (
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
              <span class="kicker shrink-0">{t.tagsLabel}</span>
              <div class="flex flex-wrap gap-2">
                {doc.tags.map((tag) => (
                  <TagChip name={tag.name} slug={tag.slug} color={tag.color} description={tag.description} />
                ))}
              </div>
            </div>
          )
        }

        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6" data-purpose="social-sharing">
          <span class="kicker shrink-0">{t.shareLabel}</span>
          <ShareButtons title={doc.title} canonicalURL={canonicalURL} />
        </div>

        <!-- Autor -->
        <div class="card flex flex-col gap-6 p-7 sm:flex-row sm:items-center lg:p-8">
          <img
            src={author.avatar}
            alt={author.name}
            class="h-20 w-20 shrink-0 rounded-full border-4 border-orange-secondary object-cover"
            loading="lazy"
          />
          <div class="flex-1">
            <p class="kicker mb-1">{t.writtenBy}</p>
            <a href={author.website} rel="author" class="text-xl font-bold tracking-tight text-gray-primary transition-colors hover:text-orange-secondary">{author.name}</a>
            <p class="mt-2 text-base leading-relaxed text-gray-primary/70">{author.bio}</p>
          </div>
          <a href={t.aboutButton.href} class="btn-outline shrink-0 !text-base">{t.aboutButton.label}</a>
        </div>

        <a href={section.link} class="group inline-flex items-center gap-2 font-bold text-orange-secondary">
          <i class="fa-solid fa-arrow-left text-sm transition-transform duration-300 group-hover:-translate-x-1" aria-hidden="true"></i>
          {fmt(t.backTo, { section: section.label })}
        </a>
      </footer>
    </div>

    <!-- Barra lateral -->
    <aside class="hidden lg:col-span-4 lg:block">
      <div class="sticky top-32 space-y-10">
        {hasToc && <TableOfContents items={portableText} variant="aside" />}

        <div class="rounded-2xl border border-white/10 bg-blue-secondary/30 p-6">
          <p class="kicker mb-4">{t.shareLabel}</p>
          <ShareButtons title={doc.title} canonicalURL={canonicalURL} />
        </div>

        <a
          href={site.nav.cta.href}
          class="group relative block overflow-hidden rounded-2xl border-2 border-orange-primary bg-blue-secondary p-6 transition-transform duration-300 hover:-translate-y-1"
        >
          <div class="halftone pointer-events-none absolute inset-0 opacity-30 [mask-image:radial-gradient(ellipse_70%_80%_at_100%_0%,#000,transparent)]" aria-hidden="true"></div>
          <p class="kicker relative mb-3 !text-orange-secondary">{t.newsletterCard.kicker}</p>
          <p class="relative text-lg font-bold leading-snug tracking-tight text-gray-primary">{t.newsletterCard.text}</p>
          <span class="relative mt-4 inline-flex items-center gap-2 text-sm font-bold text-orange-secondary">
            {t.newsletterCard.cta}
            <i class="fa-solid fa-arrow-right text-xs transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"></i>
          </span>
        </a>
      </div>
    </aside>
  </div>
</main>
